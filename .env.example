# Paths on the Docker host. On Windows, use forward slashes.
HOST_SOURCE_DIRECTORY=C:/Users/your-name/Music
HOST_OUTPUT_DIRECTORY=D:/Music_Compressed

# Five-field cron expression and its time zone.
CRON_SCHEDULE=0 3 * * *
TZ=Asia/Seoul

# true converts once when the container starts; false waits for the first schedule.
RUN_ON_START=true

# Leave blank to convert FLAC, ALAC, and MP3. Example: --format alac
CONVERTER_ARGS=

# Tailscale auth key (reusable or ephemeral) from https://login.tailscale.com/admin/settings/keys.
# Leave blank to log in manually: docker compose exec tailscale tailscale up
TS_AUTHKEY=
TS_HOSTNAME=audio-converter
